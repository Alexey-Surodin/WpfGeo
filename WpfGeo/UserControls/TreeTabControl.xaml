<UserControl x:Class="WpfGeo.UserControls.TreeTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pointsModel="clr-namespace:ClassLibrary.PointsModel;assembly=ClassLibrary"
             xmlns:view="clr-namespace:WpfGeo"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=view:GeoViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="TTC">
    <Grid>
        <TabControl IsEnabled="{Binding IsLoaded,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}">
            <TabControl.Resources>

                <!--TreeViewItem Style-->
                <!--<Style TargetType="TreeViewItem">-->
                <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem" >
                    <Setter Property="IsExpanded" Value="{Binding Path= Expanded, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    <Setter Property="IsSelected" Value="{Binding Path= Selected, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                </Style>

                <!--CheckBox Style-->
                <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
                    <Setter Property="IsThreeState" Value="True"/>
                    <Setter Property="IsChecked" Value="{Binding Path= Visible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Style>

                <!--Stack Panel Style-->
                <Style x:Key="StackPanelStyle" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal"/>
                </Style>

                <!--Hierarchical Data Template For GeoPointSlice - 1-2 Level-->
                <HierarchicalDataTemplate  DataType="{x:Type pointsModel:GeoTreeNode}" 
                    ItemsSource="{Binding Items}">
                    <StackPanel Style="{StaticResource StackPanelStyle}">
                        <CheckBox Style="{StaticResource CheckBoxStyle}"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!--Hierarchical Data Template For GeoPoint - 3 Level-->
                <DataTemplate DataType="{x:Type pointsModel:GeoPoint}">
                    <StackPanel Style="{StaticResource StackPanelStyle}">
                        <CheckBox Style="{StaticResource  CheckBoxStyle}" IsThreeState="False"/>
                        <TextBlock >
                            <Run Text="X="/>
                            <Run Text="{Binding X}"/>
                            <Run Text="; Y="/>
                            <Run Text="{Binding Y}"/>
                            <Run Text="; Z="/>
                            <Run Text="{Binding Z}"/>
                            <Run Text="; Rho="/>
                            <Run Text="{Binding Rho}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>

                <Style x:Key="MenuItemStyle" TargetType="MenuItem">
                    <Setter Property="DataContext" Value="{Binding Source={x:Reference TTC},Path=DataContext}"/>
                    <Setter Property="Command" Value="{Binding Path= RemoveVzpCommand}"/>
                    <Setter Property="CommandParameter" Value="{Binding Source={x:Reference VzTreeView}, Path=SelectedItem}"/>
                </Style>

                <Style x:Key="ExtTreeViewItemStyle"  TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemStyle}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Remove VZPoints" Style="{StaticResource MenuItemStyle}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>

            </TabControl.Resources>

            <TabItem Header="Model">
                <TreeView  ItemsSource="{Binding SourceModel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
                    SelectedItemChanged="PointTreeView_SelectedItemChanged" 
                    MouseLeftButtonDown="PointTreeView_MouseLeftButtonDown"
                    ItemContainerStyle="{StaticResource TreeViewItemStyle}">
                </TreeView>
            </TabItem>

            <TabItem Header="ZLayers">
                <TreeView ItemsSource="{Binding ZLayerModel, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
                    SelectedItemChanged="PointTreeView_SelectedItemChanged" 
                    MouseLeftButtonDown="PointTreeView_MouseLeftButtonDown"
                    ItemContainerStyle="{StaticResource TreeViewItemStyle}">
                </TreeView>
            </TabItem>

            <TabItem Header="VZ Points">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="4" 
                            Content="Load VZPoints" Command="{Binding LoadVzPointsCommand}"/>
                    <TreeView Name="VzTreeView" ItemsSource="{Binding Path=VzPoints, Mode=OneWay, UpdateSourceTrigger=PropertyChanged }"
                        SelectedItemChanged="PointTreeView_SelectedItemChanged" 
                        MouseLeftButtonDown="PointTreeView_MouseLeftButtonDown"
                        ItemContainerStyle="{DynamicResource ExtTreeViewItemStyle}">
                    </TreeView>

                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>