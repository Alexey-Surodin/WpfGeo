<UserControl x:Class="WpfGeo.UserControls.ColorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Name="CC" MinWidth="200" MinHeight="50" FontSize="10" Margin="4">
    <Grid Background="White">
        <Border BorderBrush="LightGray" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Left" Width="40" HorizontalAlignment="Center" Text="Num of Colors" TextWrapping="Wrap"/>
                    <TextBlock DockPanel.Dock="Right" Width="40" 
                       Text="{Binding ElementName=ColorSlider, Path=Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Slider x:Name="ColorSlider" Maximum="25" Minimum="1" SmallChange="1" IsSnapToTickEnabled="True"
                    Value="{Binding ElementName=CC,Path=NumOfColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </DockPanel>
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Left" Width="40" HorizontalAlignment="Center" Text="Alpha" />
                    <TextBlock DockPanel.Dock="Right" Width="40" 
                               Text="{Binding ElementName=AlphaSlider, Path=Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Slider x:Name="AlphaSlider" Maximum="100" Minimum="1" SmallChange="1" IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=CC,Path=Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="4">
                    <CheckBox x:Name="AutoScaleCheckBox" 
                              IsChecked="{Binding ElementName=CC, Path=AutoColorScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="AutoColorScale"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=AutoScaleCheckBox,Path=IsChecked}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel LastChildFill="True" Margin="4,0,4,0">
                        <TextBlock  DockPanel.Dock="Left" Width="40"  Text="Min Rho"/>
                        <TextBox  AllowDrop="False" MinWidth="40"  PreviewTextInput="TB_PreviewTextInput" 
                                  Text="{Binding ElementName=CC,Path=MinRho, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, 
                                        FallbackValue=0}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True" Margin="4,0,4,0">
                        <TextBlock  DockPanel.Dock="Left" Width="40"  Text="Max Rho"/>
                        <TextBox  AllowDrop="False" MinWidth="40" PreviewTextInput="TB_PreviewTextInput"
                                  Text="{Binding ElementName=CC,Path=MaxRho, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, 
                                        FallbackValue=20000}"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
