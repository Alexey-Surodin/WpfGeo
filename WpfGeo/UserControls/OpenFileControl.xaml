<UserControl x:Class="WpfGeo.UserControls.OpenFileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfGeo.UserControls"
             xmlns:view="clr-namespace:WpfGeo"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=view:GeoViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="OFC">
    <Grid Background="White">
        <StackPanel Margin="20" >
            <DockPanel LastChildFill="True" Margin="20">
                <Button Content="Open File" DockPanel.Dock="Right" Width="80" Margin="10,0,0,0"
                        Click="OpenFileButton_Click"/>
                <TextBox x:Name="FilePathTextBox"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <CheckBox x:Name="AMC" IsChecked="True"/>
                <TextBlock Text="AutoMeasureBorders"/>
            </StackPanel>
            <Expander Header="Borders" Margin="20" BorderBrush="LightGray" >
                <Expander.Resources>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=AMC, Path=IsChecked}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=AMC, Path=IsChecked}" Value="False">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Resources>
                <Expander.Content>
                    <StackPanel Orientation="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <local:ModelBoundaryControl x:Name="MBC"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
            <Button Content="Load" Width="80" Margin="20" 
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Click="LoadFileButton_Click"
                    Command="{Binding LoadFileCommand}"
                    CommandParameter="{Binding OpenFileParam,ElementName=OFC}"/>
        </StackPanel>
    </Grid>
</UserControl>