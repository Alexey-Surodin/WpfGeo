<UserControl x:Class="WpfGeo.UserControls.ScaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
               Name="SC" MinWidth="200" MinHeight="50" FontSize="10" Margin="4" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderBrush="Black">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4">
            <TextBlock DockPanel.Dock="Left" Width="20" HorizontalAlignment="Center" Text="kX"/>
            <TextBlock DockPanel.Dock="Right" Width="20" 
                       Text="{Binding ElementName=XSlider, Path=Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Slider x:Name="XSlider" Maximum="20" Minimum="1" SmallChange="1" IsSnapToTickEnabled="True"
                    Value="{Binding ElementName=SC, Path=ScaleFactorX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="4">
            <TextBlock DockPanel.Dock="Left" Width="20" HorizontalAlignment="Center" Text="kY" />
            <TextBlock DockPanel.Dock="Right" Width="20" 
                       Text="{Binding ElementName=YSlider, Path=Value, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Slider x:Name="YSlider" Maximum="20" Minimum="1" SmallChange="1" IsSnapToTickEnabled="True"
                    Value="{Binding ElementName=SC,Path=ScaleFactorY, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="4">
            <TextBlock DockPanel.Dock="Left" Width="20" HorizontalAlignment="Center" Text="kZ" />
            <TextBlock DockPanel.Dock="Right" Width="20" 
                       Text="{Binding ElementName=ZSlider, Path=Value, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Slider x:Name="ZSlider" Maximum="20" Minimum="0" SmallChange="1" IsSnapToTickEnabled="True"
                    Value="{Binding ElementName=SC,Path=ScaleFactorZ, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    />
        </DockPanel>
    </Grid>
</UserControl>
